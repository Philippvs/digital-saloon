# Copy to `.env` for local overrides.
# `pnpm dev:local` sets VITE_USE_FIREBASE_EMULATORS=true automatically.

# --- Emulators ---
# VITE_USE_FIREBASE_EMULATORS=true

# --- SalonFlow (single salon) ---
# VITE_SALON_ID=pilot
# Functions also read SALON_ID (default: pilot).

# Seed overrides (scripts/seed-emulator.mjs):
# SEED_SALON_NAME=SalonFlow Pilot
# SEED_SALON_TIMEZONE=Europe/Vienna
# SEED_ADMIN_EMAIL=admin@salonflow.local
# SEED_ADMIN_PASSWORD=password123

# Email (Functions env — set in production; emulator logs without keys):
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=bookings@example.com
# NOTIFICATIONS_ALLOW_LOG_ONLY=true   # non-emulator log-only; never set in production

# --- Firebase Web SDK (required for non-emulator / deployed builds) ---
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
