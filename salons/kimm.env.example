# Copy to `salons/kimm.env` (gitignored if you add `salons/*.env`) and fill in KIMM Hair's Firebase Web SDK config.
VITE_BRAND=kimm
VITE_SALON_ID=pilot
VITE_SHOW_PRICES=true
BRAND=kimm
SALON_ID=pilot

# Firebase Web SDK (from Firebase Console -> Project Settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=salon-kimm-prod
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
