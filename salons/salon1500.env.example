# Copy to `salons/salon1500.env` and fill in Salon 1500's Firebase Web SDK config.
VITE_BRAND=salon1500
VITE_SALON_ID=salon1500
VITE_SHOW_PRICES=true
BRAND=salon1500
SALON_ID=salon1500

# Firebase Web SDK (from Firebase Console -> Project Settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=salon-1500-prod
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
